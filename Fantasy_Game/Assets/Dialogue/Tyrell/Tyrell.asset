  m_Script: {fileID: 11500000, guid: 864f32d36e36a5644aa8fbd495f2626a, type: 3}
  m_Name: Tyrell
  m_EditorClassIdentifier: 
  line: Welcome to Menari! Or more specifically, my front garden. I'm glad you're
    okay, that tornado last night turned everything upside down! It even lodged a
    giant egg right in my chimney. Could I ask a favour, young chap, could you dislodge
    it for me?
  option1:
    text: Sure.
    next: {fileID: 11400000, guid: 977f1acfdd86bf5449cc938daab66994, type: 2}
    action: 0
  option2:
    text: No.
