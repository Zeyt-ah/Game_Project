  m_Script: {fileID: 11500000, guid: 864f32d36e36a5644aa8fbd495f2626a, type: 3}
  m_Name: Dayne1.1.1.1.1
  m_EditorClassIdentifier: 
  line: 'On the Gods, that thing has spread chaos across the world. I know it sounds
    crazy, but I think I saw where it came from. I was up late last night reading,
    and saw a giant streak of blue energy shoot the sky. Then the tornado formed.
    I could have sworn it came from Ashfang arena. '
  option1:
    text: 'Interesting. Thats where Doctor Dibbler''s lab is. '
    next: {fileID: 11400000, guid: e052c9735659b5e4493df3f8e3de36d6, type: 2}
    action: 0
  option2:
    text: Sure thing buddy, any way, I need to get up the volcano.
    next: {fileID: 11400000, guid: 1aa624acf2318de47b4de1783c4070b2, type: 2}
    action: 0
