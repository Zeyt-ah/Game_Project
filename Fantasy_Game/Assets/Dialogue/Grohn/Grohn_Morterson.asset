  m_Name: Grohn_Morterson
  m_EditorClassIdentifier: 
  line: "Morterson trusts Old Dibbler because Dibbler talks like he already knows
    the ending. I don\u2019t trust men like that. Too much charm, not enough truth."
  option1:
    text: Who should I talk to then?
    next: {fileID: 11400000, guid: 134a928f3586d484787d9ce967d28be8, type: 2}
    action: 0
  option2:
    text: "I\u2019ll keep that in mind."
