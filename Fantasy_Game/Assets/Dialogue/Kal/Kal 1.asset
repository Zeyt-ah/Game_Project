  m_Script: {fileID: 11500000, guid: 864f32d36e36a5644aa8fbd495f2626a, type: 3}
  m_Name: Kal 1
  m_EditorClassIdentifier: 
  line: 'You didn''t hear? By the stars, Everyone in Helver is so disconnected! Last
    night the dam broke, It was destroyed by that tornado. Damton flooded. Everyone
    died. Everyone, except little Billy over there. The sole survivor. Poor child.
    My husband found him freezing in the woods this morning. He hasn''t said a word
    since. I don''t know when he will. '
  option1:
    text: That's horrible. I'm so sorry.
    next: {fileID: 11400000, guid: 950649657df3d3c48aaf86dc16e5fdb7, type: 2}
    action: 0
  option2:
    text: Damton?
    next: {fileID: 11400000, guid: 950649657df3d3c48aaf86dc16e5fdb7, type: 2}
    action: 0
