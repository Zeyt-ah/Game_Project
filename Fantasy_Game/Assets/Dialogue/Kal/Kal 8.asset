  m_Script: {fileID: 11500000, guid: 864f32d36e36a5644aa8fbd495f2626a, type: 3}
  m_Name: Kal 8
  m_EditorClassIdentifier: 
  line: well, I was picking berries in the forest by Damton, and dropped my bag,
    then it rolled down into the ravine. The place is always filled with stone golems,
    I don't dare go down to retrieve it. We have no weapons here. Could you retrieve
    it for me? It's filled with berries and we need all the food we can get.
  option1:
    text: I will help you.
    next: {fileID: 11400000, guid: 47e8427a489192f4ea65f47f7416bb5f, type: 2}
    action: 0
  option2:
    text: I'm just going to take the egg.
    next: {fileID: 0}
    action: 0
