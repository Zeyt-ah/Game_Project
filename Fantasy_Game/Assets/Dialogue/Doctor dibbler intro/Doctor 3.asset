  m_Script: {fileID: 11500000, guid: 864f32d36e36a5644aa8fbd495f2626a, type: 3}
  m_Name: Doctor 3
  m_EditorClassIdentifier: 
  line: 'We must gather all the Eggs to one place, to use them as bait. Then, I will
    slay the foul beast, freeing all in the land from living in fear.

    I need
    you to collect all five eggs, so I can go and set up the trap. I will reward
    you with ten thousand gold pieces and a journey home. You have my word. '
  option1:
    text: Okay I'll do it, if you can get me home.
    next: {fileID: 11400000, guid: b3e6566b843142948b5909fd0e34bc70, type: 2}
    action: 0
  option2:
    text: Why me? I just want to go home.
    next: {fileID: 11400000, guid: caee50063c0499e469ba93f33c9eb04e, type: 2}
    action: 0
